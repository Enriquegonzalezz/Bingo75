# =============================================================================
# .dockerignore - Archivos a ignorar durante el build de Docker
# =============================================================================

# Dependencias
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next
out

# Archivos de entorno locales
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor y sistema
.DS_Store
*.swp
*.swo
.idea
.vscode

# Git
.git
.gitignore

# Testing
coverage
tests
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Documentación
*.md
!README.md

# Archivos de configuración de desarrollo
vitest.config.ts
eslint.config.mjs

# Scripts de desarrollo
scripts
