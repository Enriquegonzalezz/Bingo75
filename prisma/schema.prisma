// ============================================================================
// SCHEMA DE PRISMA PARA BINGO75 - MySQL
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TABLA: Paquete
// ============================================================================
model Paquete {
  id                String   @id @default(cuid())
  paquete_id        String   @unique @db.VarChar(255)
  nombre            String   @db.VarChar(255)
  version           String   @default("1.0") @db.VarChar(50)
  fecha_generacion  DateTime @default(now())
  total_cartones    Int
  descripcion       String?  @db.Text
  serial            String   @default("BINGO") @db.VarChar(100)

  cartones          Carton[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paquete_id])
  @@index([fecha_generacion])
}

// ============================================================================
// TABLA: Carton
// ============================================================================
model Carton {
  id             String   @id @default(cuid())
  carton_id      String   @unique @db.VarChar(255)
  numero_carton  Int
  serial         String   @db.VarChar(100)

  paquete_id     String
  paquete        Paquete  @relation(fields: [paquete_id], references: [id], onDelete: Cascade)

  numeros_b      Json
  numeros_i      Json
  numeros_n      Json
  numeros_g      Json
  numeros_o      Json

  matriz         Json

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([paquete_id])
  @@index([numero_carton])
}
